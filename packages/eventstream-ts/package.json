{
  "name": "@omega-prime/eventstream",
  "version": "0.1.0",
  "description": "Broker-agnostic Omega Prime event-stream SDK",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --exclude test/schema-contract.test.ts",
    "test:contract": "vitest run test/schema-contract.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc"
  },
  "peerDependencies": {
    "pulsar-client": "1.18.0"
  },
  "peerDependenciesMeta": {
    "pulsar-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
