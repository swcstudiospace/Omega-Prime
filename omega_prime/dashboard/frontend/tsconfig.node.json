{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "types": ["node"],
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.cache/tsbuild"
  },
  "include": ["vite.config.ts"]
}
