          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "const": "login"
        }
      },
      "required": [
        "host",
        "tool",
        "session_id",
        "actor",
        "action"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "host": "github.com",
          "tool": "gh",
          "session_id": "s-1",
          "actor": "octocat",
          "action": "login"
        }
