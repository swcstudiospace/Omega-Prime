{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omega:schema:ci:1",
  "title": "Omega ci payload contracts",
  "$defs": {
    "omega.ci.run.started": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "head_sha": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "queued",
            "in_progress"
          ]
        }
      },
      "required": [
        "repo",
        "number",
        "run_id",
        "head_sha",
        "actor",
        "status"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "repo": "Omega-Prime",
          "number": 75,
          "run_id": "r-1",
          "head_sha": "b8eb05f",
          "actor": "github",
          "status": "in_progress"
        }
      ],
      "x-omega-invalid-examples": [
        {
          "repo": "",
          "number": 75,
          "run_id": "r-1",
          "head_sha": "b8eb05f",
          "actor": "github",
          "status": "in_progress"
        }
      ]
    },
