# omega-ci autoscaler controller (always-on, VPS). TEMPLATE — NOT INSTALLED.
#
# Installing, enabling or starting this unit is a VPS change that is HELD for
# the operator (D-120-10). See docs/ci-runners-repo-setup.md.
#
# Before installing:
#   * the port: 8788 is the CLI default; the production VPS uses 8798
#     because 8788 is already taken there. Keep it equal to the proxy's
#     upstream (Caddyfile.snippet or nginx-site.conf.example).
#   * replace /opt/omega-ci-venv with the virtualenv that has
#     `pip install 'omega-prime[ci-runners]' cryptography`
#   * create the unprivileged system account `omega-ci` (no login shell)
#   * create /etc/omega-ci/controller.env from env.example (mode 0640, root:omega-ci)
#   * put secret files under /etc/omega-ci/secrets/ (owner omega-ci, mode 0600;
#     the credential broker refuses group/other-readable secret files)
#
# Non-installing validation:
#   systemd-analyze verify deploy/ci-runner-controller/omega-ci-autoscaler.service
#
# Event-driven service, not a timer: there is no .timer unit and no schedule.

[Unit]
Description=omega-ci autoscaler controller (GitHub workflow_job -> ephemeral runners)
Documentation=https://github.com/actions/runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=omega-ci
Group=omega-ci
EnvironmentFile=/etc/omega-ci/controller.env
ExecStart=/opt/omega-ci-venv/bin/python -m omega_prime.ci_runners controller --host 127.0.0.1 --port 8788
Restart=on-failure
RestartSec=5s

# Writable state: only /var/lib/omega-ci (OMEGA_CI_EVENTS_PATH and the
# restart backlog OMEGA_CI_DEMAND_PATH).
StateDirectory=omega-ci
StateDirectoryMode=0750
UMask=0077

# Least privilege.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
ReadOnlyPaths=/etc/omega-ci

[Install]
WantedBy=multi-user.target
