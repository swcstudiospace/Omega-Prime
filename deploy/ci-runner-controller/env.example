# omega-ci controller settings. TEMPLATE — placeholders only, no secret values.
# Copy to /etc/omega-ci/controller.env (mode 0640, root:omega-ci) at install
# time (HELD, D-120-10). Secrets are referenced by FILE PATH only; the files
# themselves live under /etc/omega-ci/secrets/, owned by omega-ci with mode
# 0600; the credential broker refuses any group/other-readable secret file.
# Agent-only settings (OMEGA_CI_AGENT_*) belong on the Railway service, not here.

# Scope: org (default) or repo. Repo scope needs OMEGA_CI_REPO=owner/repo.
OMEGA_CI_SCOPE=org
OMEGA_CI_ORG=your-org
# OMEGA_CI_REPO=owner/repo

# The controller listens on loopback; production runs it with --port 8798
# (8788 is taken on the VPS) behind the nginx site nginx-site.conf.example.

# Allowlist (comma-separated): owner/repo names or the owner wildcard owner/*
# (every repo of that owner that is not itself a GitHub fork; list a fork by
# its exact name). No bare *, no partial globs. Empty = every private repo the
# runner group allows. Public repos additionally need OMEGA_CI_PUBLIC_REPOS.
# Org-wide setup (swcstudiospace, since 2026-10-24):
#   OMEGA_CI_REPOS=swcstudiospace/*
OMEGA_CI_REPOS=your-org/repo-one,your-org/repo-two

# Public repositories explicitly opted in (comma-separated owner/repo or
# owner/*; each entry must be covered by OMEGA_CI_REPOS, and owner/* only by
# owner/*). Default empty: public repos are refused. An opted-in public repo is
# served only after the fork guard fetches the job's workflow run and confirms
# a same-repo push / workflow_dispatch / pull_request. Read "Public
# repositories" in docs/ci-runners.md before setting this, and set the org's
# "Require approval for all outside collaborators" fork policy.
# Org-wide setup:
#   OMEGA_CI_PUBLIC_REPOS=swcstudiospace/*
# OMEGA_CI_PUBLIC_REPOS=your-org/public-repo

# Pool labels (a job matches when its runs-on labels are a subset of these).
OMEGA_CI_LABELS=self-hosted,linux,x64,omega-ci

# Runner group: display name plus its NUMERIC id (never inferred from the name).
OMEGA_CI_RUNNER_GROUP=omega-ci
OMEGA_CI_RUNNER_GROUP_ID=0

# Capacity and timing (defaults shown; hard ceiling 10 runners).
OMEGA_CI_MAX_RUNNERS=8
OMEGA_CI_IDLE_GRACE_S=180
OMEGA_CI_WAKE_BUDGET_S=150

# GitHub auth: EITHER the App (all three) OR a PAT file — never both.
# The App key file is the PRIVATE KEY (.pem) from the "Private keys" section
# at the bottom of the App's General settings page. A "client secret" is a
# different value (OAuth only) and does not work here.
OMEGA_CI_GITHUB_APP_ID=0
OMEGA_CI_GITHUB_INSTALLATION_ID=0
OMEGA_CI_GITHUB_APP_KEY_FILE=/etc/omega-ci/secrets/github-app.pem
# OMEGA_CI_GITHUB_PAT_FILE=/etc/omega-ci/secrets/github-pat

# Webhook HMAC secret (same value as configured on the GitHub App webhook).
OMEGA_CI_WEBHOOK_SECRET_FILE=/etc/omega-ci/secrets/webhook-secret

# Railway Desktop runner agent: its 8787 domain and the shared bearer token
# (the same value as the agent's OMEGA_CI_AGENT_TOKEN).
OMEGA_CI_DESKTOP_URL=https://agent.example.com
OMEGA_CI_DESKTOP_TOKEN_FILE=/etc/omega-ci/secrets/desktop-token

# Events: jsonl (default), null, or eventstream (once the event stream lands).
OMEGA_CI_PUBLISHER=jsonl
OMEGA_CI_EVENTS_PATH=/var/lib/omega-ci/events.jsonl
# Queued-job backlog replayed after a restart (non-secret job fields only).
OMEGA_CI_DEMAND_PATH=/var/lib/omega-ci/demand.json
